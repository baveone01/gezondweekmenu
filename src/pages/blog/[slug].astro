---
import Layout from '../../layouts/Layout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { blogPosts, blogBySlug } from '../../data/blogs';
import { recipes, recipeBySlug } from '../../data/recipes';
import { foodImage } from '../../data/types';

export function getStaticPaths() {
  return blogPosts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const canonical = `/blog/${post.slug}/`;
const relatedRecipes = (post.relatedRecipeSlugs ?? [])
  .map(recipeBySlug)
  .filter((r): r is NonNullable<typeof r> => Boolean(r));
const morePosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.title,
      description: post.description,
      image: [foodImage(post.imagePrompt)],
      datePublished: post.updatedAt + '-01',
      dateModified: post.updatedAt + '-01',
      author: { '@type': 'Organization', name: 'Gezondweekmenu.nl' },
      publisher: { '@type': 'Organization', name: 'Gezondweekmenu.nl' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://gezondweekmenu.nl' + canonical },
    },
    {
      '@type': 'FAQPage',
      mainEntity: post.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout title={post.metaTitle} description={post.description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <nav class="mb-4 text-sm text-gray-500">
    <a href="/" class="hover:text-brand-600">Home</a> / <a href="/blog/" class="hover:text-brand-600">Blog</a> / {post.title}
  </nav>

  <article class="mx-auto max-w-3xl">
    <header>
      <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{post.category}</span>
      <h1 class="mt-3 font-serif text-3xl font-extrabold leading-tight text-gray-900 sm:text-4xl">{post.title}</h1>
      <p class="mt-3 text-gray-600">{post.description}</p>
      <img src={foodImage(post.imagePrompt)} alt={post.title} class="mt-6 h-72 w-full rounded-2xl object-cover shadow-soft" loading="eager" />
    </header>

    <div class="mt-8 space-y-8">
      {post.body.map((section) => (
        <section>
          <h2 class="mb-3 font-serif text-2xl font-bold text-gray-900">{section.heading}</h2>
          {section.paragraphs.map((p) => <p class="mb-3 leading-relaxed text-gray-700">{p}</p>)}
        </section>
      ))}
    </div>

    {relatedRecipes.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-4 font-serif text-2xl font-bold text-gray-900">Bijpassende gezonde recepten</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedRecipes.map((r) => <RecipeCard recipe={r} />)}
        </div>
      </section>
    )}

    {post.faq.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 font-serif text-2xl font-bold text-gray-900">Veelgestelde vragen</h2>
        <div class="space-y-3">
          {post.faq.map((f, i) => (
            <details class="group rounded-2xl border border-gray-200 bg-white" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-gray-900">
                {f.q}
                <span class="text-brand-600 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="border-t border-gray-100 px-4 py-3 text-sm text-gray-600">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </article>

  <section class="mt-12">
    <h2 class="mb-4 font-serif text-2xl font-bold text-gray-900">Meer van onze blog</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {morePosts.map((p) => (
        <a href={`/blog/${p.slug}/`} class="group block overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-soft transition-all hover:-translate-y-1 hover:shadow-lift">
          <div class="relative h-36 overflow-hidden">
            <img src={foodImage(p.imagePrompt)} alt={p.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="p-4">
            <h3 class="font-serif text-base font-semibold leading-snug text-gray-900 group-hover:text-brand-700">{p.title}</h3>
            <div class="mt-1 text-xs text-gray-500">⏱ {p.readingTime} min</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>