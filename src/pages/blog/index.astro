---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blogs';
import { foodImage } from '../../data/types';

const cats = [...new Set(blogPosts.map((b) => b.category))];
---

<Layout
  title="Gezond blog & voedingstips | Gezondweekmenu.nl"
  description="Lees onze artikelen over gezond eten: calorieën, eiwitten, snelle gezonde avondgerechten en meer. Praktische tips om elke dag gezond te eten."
  canonical="/blog/"
>
  <nav class="mb-4 text-sm text-gray-500"><a href="/" class="hover:text-brand-600">Home</a> / Blog</nav>
  <header class="mb-6 max-w-2xl">
    <h1 class="font-serif text-3xl font-extrabold text-gray-900">Gezond blog</h1>
    <p class="mt-2 text-gray-600">
      Praktische artikelen over gezond eten, voedingsstoffen en snelle recepten. Combineer de tips met onze weekmenu's voor een makkelijke gezonde week.
    </p>
  </header>

  <div class="mb-6 flex flex-wrap gap-2">
    <a href="/blog/" class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Alle</a>
    {cats.map((c) => (
      <span class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600">{c}</span>
    ))}
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {blogPosts.map((p) => (
      <a href={`/blog/${p.slug}/`} class="group block overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-soft transition-all hover:-translate-y-1 hover:shadow-lift">
        <div class="relative h-44 overflow-hidden">
          <img src={foodImage(p.imagePrompt)} alt={p.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-brand-700 backdrop-blur">{p.category}</span>
        </div>
        <div class="p-4">
          <h2 class="font-serif text-lg font-semibold leading-snug text-gray-900 group-hover:text-brand-700">{p.title}</h2>
          <p class="mt-1 line-clamp-2 text-sm text-gray-500">{p.description}</p>
          <div class="mt-3 text-xs text-gray-500">⏱ {p.readingTime} min leestijd</div>
        </div>
      </a>
    ))}
  </div>
</Layout>