---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Gezondweekmenu.nl" description="Neem contact op met Gezondweekmenu.nl voor vragen of suggesties." canonical="/contact/">
  <nav class="mb-4 text-sm text-gray-500"><a href="/" class="hover:text-brand-600">Home</a> / Contact</nav>
  <article class="mx-auto max-w-2xl space-y-4">
    <h1 class="font-serif text-3xl font-extrabold text-gray-900">Contact</h1>
    <p class="text-gray-600">
      Vragen over een recept, een weekmenu of een suggestie voor een nieuw gerecht? We horen graag van je.
      Stuur een e-mail naar:
    </p>
    <p class="rounded-2xl border border-gray-200 bg-white p-4 font-semibold text-brand-700">
      contact@gezondweekmenu.snapvit.com
    </p>
    <p class="text-sm text-gray-500">
      We streven ernaar binnen 2 werkdagen te antwoorden. Vragen over medisch of voedingsadvies beantwoorden we
      niet; raadpleeg daarvoor een diëtist of huisarts.
    </p>
  </article>
</Layout>