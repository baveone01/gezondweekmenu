---
import Layout from '../../layouts/Layout.astro';
import MenuCard from '../../components/MenuCard.astro';
import { weekmenus, weekmenuBySlug } from '../../data/weekmenus';
import { recipeBySlug, recipesByCategory } from '../../data/recipes';
import { CATEGORY_LABEL, imagePath } from '../../data/types';

export function getStaticPaths() {
  return weekmenus.map((m) => ({ params: { slug: m.slug }, props: { menu: m } }));
}

const { menu } = Astro.props;
const relatedMenus = weekmenus.filter((m) => m.slug !== menu.slug).slice(0, 2);

// Verzamel unieke recepten die in dit menu gelinkt zijn, voor internal linking
const linkedSlugs = new Set<string>();
menu.days.forEach((d) => {
  [d.ontbijt, d.lunch, d.avondeten, d.snack].forEach((meal) => {
    if (meal.recipeSlug) linkedSlugs.add(meal.recipeSlug);
  });
});
const linkedRecipes = [...linkedSlugs].map(recipeBySlug).filter((r): r is NonNullable<typeof r> => Boolean(r));

const title = `${menu.title} met boodschappenlijst`;
const canonical = `/weekmenu/${menu.slug}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: menu.title,
  numberOfItems: 7,
  itemListElement: menu.days.map((d, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${d.day}: ${d.avondeten.text}`,
  })),
};
---

<Layout title={title} description={menu.description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <nav class="mb-4 text-sm text-gray-500">
    <a href="/" class="hover:text-brand-600">Home</a> / <a href="/weekmenu/" class="hover:text-brand-600">Weekmenu’s</a> / {menu.weekLabel}
  </nav>

  <article class="mx-auto max-w-4xl">
    <header class="text-center">
      <span class="inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{menu.weekLabel}</span>
      <h1 class="mt-3 font-serif text-3xl font-extrabold text-gray-900 sm:text-4xl">{menu.title}</h1>
      <p class="mx-auto mt-3 max-w-2xl text-gray-600">{menu.intro}</p>
      <img
        src={imagePath(menu.slug)}
        alt={menu.title}
        class="mt-6 h-64 w-full rounded-2xl object-cover shadow-soft sm:h-80"
        loading="eager"
      />
    </header>

    <!-- Daily schedule -->
    <section class="mt-10">
      <h2 class="mb-4 font-serif text-2xl font-bold text-gray-900">Het menu per dag</h2>
      <div class="space-y-4">
        {menu.days.map((d) => (
          <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white">
            <div class="flex items-center justify-between bg-brand-50 px-4 py-2.5">
              <span class="font-serif text-lg font-bold text-brand-800">{d.day}</span>
              <span class="text-sm text-brand-700">{d.theme}</span>
            </div>
            <div class="grid gap-3 p-4 sm:grid-cols-2">
              {[
                { label: 'Ontbijt', meal: d.ontbijt },
                { label: 'Lunch', meal: d.lunch },
                { label: 'Avondeten', meal: d.avondeten },
                { label: 'Snack', meal: d.snack },
              ].map((row) => (
                <div class="flex items-start gap-2 text-sm">
                  <span class="w-22 shrink-0 font-semibold text-gray-500">{row.label}:</span>
                  {row.meal.recipeSlug
                    ? <a href={`/recepten/${row.meal.recipeSlug}/`} class="text-brand-700 underline-offset-2 hover:underline">{row.meal.text}</a>
                    : <span class="text-gray-800">{row.meal.text}</span>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Shopping list -->
    <section class="mt-10 rounded-2xl border border-gray-200 bg-white p-6">
      <h2 class="mb-1 font-serif text-2xl font-bold text-gray-900">Boodschappenlijst</h2>
      <p class="mb-4 text-sm text-gray-500">Vink aan wat je in huis hebt en neem de rest mee naar de supermarkt.</p>
      <div class="grid gap-5 sm:grid-cols-2">
        {menu.shoppingList.map((g) => (
          <div>
            <h3 class="mb-2 text-sm font-bold text-brand-700">{g.group}</h3>
            <ul class="space-y-1.5">
              {g.items.map((it) => (
                <li class="flex items-start gap-2 text-sm text-gray-700">
                  <input type="checkbox" class="mt-1 h-3.5 w-3.5 accent-brand-600" />
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a href="/boodschappenlijst/" class="mt-5 inline-block rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">
        Open de boodschappenlijst-generator
      </a>
    </section>

    <!-- Prep tips -->
    {menu.prepTips.length > 0 && (
      <section class="mt-8 rounded-2xl border border-accent-200 bg-accent-50 p-6">
        <h2 class="mb-3 font-serif text-xl font-bold text-accent-800">Meal prep tips</h2>
        <ul class="space-y-2 text-sm text-gray-700">
          {menu.prepTips.map((t) => (
            <li class="flex gap-2"><span class="text-accent-600">💡</span><span>{t}</span></li>
          ))}
        </ul>
      </section>
    )}

    <!-- Linked recipes -->
    {linkedRecipes.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 font-serif text-xl font-bold text-gray-900">Recepten uit dit weekmenu</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {linkedRecipes.map((r) => (
            <a href={`/recepten/${r.slug}/`} class="flex items-center gap-3 rounded-2xl border border-gray-200 bg-white p-3 hover:border-brand-300">
              <img src={imagePath(r.slug)} alt={r.title} class="h-16 w-16 rounded-xl object-cover" loading="lazy" />
              <div>
                <div class="text-sm font-semibold text-gray-800">{r.title}</div>
                <div class="text-xs text-gray-500">{CATEGORY_LABEL[r.category]}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ -->
    {menu.faq.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 font-serif text-2xl font-bold text-gray-900">Veelgestelde vragen</h2>
        <div class="space-y-3">
          {menu.faq.map((f, i) => (
            <details class="group rounded-2xl border border-gray-200 bg-white" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-gray-900">
                {f.q}
                <span class="text-brand-600 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="border-t border-gray-100 px-4 py-3 text-sm text-gray-600">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <p class="mt-8 rounded-2xl border border-gray-200 bg-white p-4 text-xs text-gray-500">
      ⚠️ Disclaimer: dit weekmenu is louter informatief en geen medisch of voedingsadvies. Raadpleeg bij vragen je huisarts of een diëtist.
    </p>
  </article>

  {relatedMenus.length > 0 && (
    <section class="mt-12">
      <h2 class="mb-4 font-serif text-2xl font-bold text-gray-900">Andere weekmenu’s</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {relatedMenus.map((m) => <MenuCard menu={m} />)}
      </div>
    </section>
  )}
</Layout>